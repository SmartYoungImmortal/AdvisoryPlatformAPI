NODE_ENV=development
# 4000, not 3000. The Next.js frontend's `next dev` takes 3000, so an API on 3000
# either loses the bind or takes the port the app is being viewed on. Cloud Run
# injects its own PORT and ignores this.
PORT=4000

# ── Application database: Supabase ───────────────────────────────────────────────
# The API's data lives in the shared Supabase project, not in a database on your
# machine. Copy the connection string from Supabase → Project Settings → Database.
#
# Use the SESSION pooler (port 5432), not the transaction pooler (6543). Transaction
# pooling hands out a different backend per statement, which breaks the session-level
# advisory lock `drizzle-kit migrate` takes, and would break booking creation's
# per-Advisor lock the same way.
#
# `uselibpqcompat=true` is required: node-postgres reads bare `sslmode=require` as
# `verify-full`, which fails against Supabase's chain with SELF_SIGNED_CERT_IN_CHAIN.
# The flag restores libpq's meaning — encrypt, do not verify the certificate.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?uselibpqcompat=true&sslmode=require

# ── Test database: local Docker Postgres ─────────────────────────────────────────
# `pnpm test:integration` and `pnpm test:e2e` TRUNCATE, DROP and DELETE to reach a
# clean slate, so they get their own throwaway database and never touch Supabase.
# `test/setup-test-env.ts` refuses to run the suites against a non-local host.
# Start it with `docker compose up -d postgres`; the credentials must match the
# POSTGRES_* values below.
POSTGRES_USER=advisory
POSTGRES_PASSWORD=
POSTGRES_DB=advisory_platform
TEST_DATABASE_URL=postgresql://advisory:<POSTGRES_PASSWORD>@localhost:5432/advisory_platform

# 32+ char random string, e.g. `openssl rand -hex 32`. Never commit a real value.
BETTER_AUTH_SECRET=
# Where this API is reachable — better-auth builds callback and cookie URLs from it.
# Must match PORT above, or the cookie is issued for an origin nothing is serving.
BETTER_AUTH_URL=http://localhost:4000
# Comma-separated origins allowed to call this API with the session cookie (the Next.js
# frontend). Anything not listed gets a 403 from better-auth and a blocked CORS preflight.
#
# This is the frontend's origin, not this API's, and it was 3001 while `next dev`
# serves 3000 — so a browser sign-in from the dev app was refused before it began,
# and the refusal arrives as a CORS failure, which the client cannot read and
# reports as "the API could not be reached". Two hours of looking in the wrong place.
TRUSTED_ORIGINS=http://localhost:3000

# Local SeaweedFS S3 gateway. Docker Compose passes these values to SeaweedFS as standard AWS
# credentials and pre-creates SEAWEEDFS_S3_BUCKET. The API still verifies the bucket before use.
# Replace the credentials outside local development; never commit real production credentials.
SEAWEEDFS_S3_ENDPOINT=localhost
SEAWEEDFS_S3_PORT=8333
SEAWEEDFS_S3_USE_SSL=false
SEAWEEDFS_S3_ACCESS_KEY=seaweedfsadmin
SEAWEEDFS_S3_SECRET_KEY=seaweedfsadmin
SEAWEEDFS_S3_BUCKET=advisory-platform
SEAWEEDFS_S3_REGION=us-east-1

# Read as CURRENCY_CODE by src/config/env.schema.ts.
CURRENCY_CODE=thb
OMISE_PUBLIC_KEY=
OMISE_SECRET_KEY=
