NODE_ENV=development
PORT=3000

POSTGRES_USER=advisory
POSTGRES_PASSWORD=
POSTGRES_DB=advisory_platform
# Must match POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB above
DATABASE_URL=postgresql://advisory:<POSTGRES_PASSWORD>@localhost:5432/advisory_platform

# 32+ char random string, e.g. `openssl rand -hex 32`. Never commit a real value.
BETTER_AUTH_SECRET=
# Where this API is reachable — better-auth builds callback and cookie URLs from it.
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated origins allowed to call this API with the session cookie (the Next.js
# frontend). Anything not listed gets a 403 from better-auth and a blocked CORS preflight.
TRUSTED_ORIGINS=http://localhost:3001
