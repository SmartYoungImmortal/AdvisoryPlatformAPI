NODE_ENV=development
PORT=3000

POSTGRES_USER=advisory
POSTGRES_PASSWORD=
POSTGRES_DB=advisory_platform
# Must match POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB above
DATABASE_URL=postgresql://advisory:<POSTGRES_PASSWORD>@localhost:5432/advisory_platform

# 32+ char random string, e.g. `openssl rand -hex 32`. Never commit a real value.
BETTER_AUTH_SECRET=
# Where this API is reachable — better-auth builds callback and cookie URLs from it.
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated origins allowed to call this API with the session cookie (the Next.js
# frontend). Anything not listed gets a 403 from better-auth and a blocked CORS preflight.
TRUSTED_ORIGINS=http://localhost:3001

# Local MinIO object storage. Replace the credentials outside local development; never commit real
# production credentials. The API creates MINIO_BUCKET automatically on the first upload.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=advisory-platform

# Self-hosted Jitsi Meet with JWT authentication. JITSI_APP_ID and JITSI_APP_SECRET must match
# JWT_APP_ID and JWT_APP_SECRET on the Jitsi deployment. Keep anonymous/empty-token access off.
JITSI_DOMAIN=meet.example.com
JITSI_APP_ID=advisory-platform
# 32+ char random string. Never reuse BETTER_AUTH_SECRET or commit a real value.
JITSI_APP_SECRET=
JITSI_ACCESS_BUFFER_MINUTES=15
